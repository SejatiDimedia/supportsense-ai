# Application
APP_NAME=SupportSense-AI
APP_PORT=8000
LOG_LEVEL=INFO

# Ollama LLM & Embedding Service (Local Native)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:latest
EMBEDDING_MODEL=nomic-embed-text

# Chroma Vector Store
CHROMA_PERSIST_DIR=./data/chroma

# n8n Escalation Webhook
N8N_WEBHOOK_URL=http://localhost:5678/webhook/escalation

# SQLite Persistence
DATABASE_URL=sqlite:///./data/support_assistant.db
